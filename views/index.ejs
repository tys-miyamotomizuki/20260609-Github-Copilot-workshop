<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <title>ポモドーロタイマー</title>
    <link href="/css/main.css" rel="stylesheet" type="text/css">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta property="og:title" content="ポモドーロタイマー">
    <meta property="og:description" content="視覚的フィードバックで集中を支えるポモドーロタイマー">
  </head>
  <body>
    <div class="ambient-stage" aria-hidden="true">
      <div class="ambient-glow"></div>
      <div class="ambient-ripple ambient-ripple--one"></div>
      <div class="ambient-ripple ambient-ripple--two"></div>
      <div class="ambient-particles"></div>
    </div>

    <main class="pomodoro-app">
      <header class="hero">
        <p class="eyebrow">Focus Lab</p>
        <h1>ポモドーロタイマー</h1>
        <p class="hero-copy">
          円形プログレスと背景アニメーションで、集中のリズムを直感的に保ちます。
        </p>
      </header>

      <section class="timer-card">
        <div
          class="progress-ring"
          data-progress-ring
          role="img"
          aria-label="残り時間の進行状況"
        >
          <div class="progress-ring__inner">
            <span class="mode-label" data-mode-label>集中時間</span>
            <time class="time-display" data-time-display aria-live="polite">25:00</time>
            <span class="status-label" data-status-label>開始準備完了</span>
          </div>
        </div>

        <div class="mode-switcher" role="group" aria-label="タイマーモード">
          <button class="mode-button is-active" data-mode="focus" type="button">集中 25分</button>
          <button class="mode-button" data-mode="break" type="button">休憩 5分</button>
        </div>

        <div class="control-row">
          <button class="primary-button" data-action="start" type="button">開始</button>
          <button class="secondary-button" data-action="pause" type="button">一時停止</button>
          <button class="secondary-button" data-action="reset" type="button">リセット</button>
        </div>
      </section>

      <section class="settings-card" aria-label="視覚フィードバック設定">
        <h2>視覚フィードバック</h2>
        <label class="setting-item">
          <input data-setting="smoothAnimation" type="checkbox" checked>
          <span>円形プログレスを滑らかに減少させる</span>
        </label>
        <label class="setting-item">
          <input data-setting="dynamicColor" type="checkbox" checked>
          <span>プログレスバー色を青→黄→赤に変化させる</span>
        </label>
        <label class="setting-item">
          <input data-setting="ambientEffect" type="checkbox" checked>
          <span>集中時間中の背景エフェクトを有効にする</span>
        </label>
      </section>

      <section class="dashboard card metrics">
        <div>
          <p class="label">レベル</p>
          <p class="value">Lv <%= dashboard.level %></p>
        </div>
        <div>
          <p class="label">経験値（XP）</p>
          <p class="value"><%= dashboard.xp %> XP</p>
          <p class="subtle">次のレベルまで <%= dashboard.xpToNextLevel %> XP</p>
        </div>
        <div>
          <p class="label">連続達成</p>
          <p class="value"><%= dashboard.streakDays %> 日</p>
        </div>
      </section>

      <section class="dashboard card">
        <h2>タイマー完了を記録</h2>
        <form method="post" action="/timer/complete" class="complete-form">
          <label for="focusMinutes">集中時間（分）</label>
          <input id="focusMinutes" name="focusMinutes" type="number" min="1" max="60" value="25">
          <button type="submit">+ セッション完了</button>
        </form>
      </section>

      <section class="dashboard card">
        <h2>達成バッジ</h2>
        <div class="badges">
          <% dashboard.badges.forEach((badge) => { %>
            <span class="badge <%= badge.unlocked ? 'unlocked' : 'locked' %>"><%= badge.name %></span>
          <% }) %>
        </div>
      </section>

      <section class="dashboard card">
        <h2>週間詳細統計</h2>
        <p>完了率: <%= dashboard.weeklyStats.summary.completionRate %>% / 平均集中時間: <%= dashboard.weeklyStats.summary.avgFocusMinutes %>分</p>
        <ul class="graph-list">
          <% dashboard.weeklyStats.items.forEach((item) => { %>
            <li>
              <span class="graph-label"><%= item.label %></span>
              <div class="bar completion"><span style="width: <%= item.completionRate %>%"></span></div>
              <span class="graph-value"><%= item.completionRate %>%</span>
            </li>
          <% }) %>
        </ul>
      </section>

      <section class="dashboard card">
        <h2>月間詳細統計</h2>
        <p>完了率: <%= dashboard.monthlyStats.summary.completionRate %>% / 平均集中時間: <%= dashboard.monthlyStats.summary.avgFocusMinutes %>分</p>
        <ul class="graph-list">
          <% dashboard.monthlyStats.items.forEach((item) => { %>
            <li>
              <span class="graph-label"><%= item.label %></span>
              <div class="bar focus"><span style="width: <%= Math.min(100, Math.round((item.avgFocusMinutes / 60) * 100)) %>%"></span></div>
              <span class="graph-value"><%= item.avgFocusMinutes %>分</span>
            </li>
          <% }) %>
        </ul>
      </section>
    </main>

    <script src="/js/pomodoro.js"></script>
  </body>
</html>
