<!DOCTYPE html>
<html lang="ja" data-theme="dark">
  <head>
    <meta charset="UTF-8">
    <title>ポモドーロタイマー</title>
    <script>
      (function () {
        try {
          const stored = JSON.parse(localStorage.getItem('pomodoro-settings'));
          const theme = stored && stored.theme;
          if (['dark', 'light', 'focus'].includes(theme)) {
            document.documentElement.dataset.theme = theme;
          }
        } catch (error) {}
      })();
    </script>
    <link href="/css/main.css" rel="stylesheet" type="text/css">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta property="og:title" content="ポモドーロタイマー">
    <meta property="og:description" content="カスタマイズ設定と達成状況を保存できるポモドーロタイマー">
  </head>
  <body>
    <main class="app-shell">
      <section class="timer-card">
        <p class="eyebrow">Customizable productivity timer</p>
        <h1>ポモドーロタイマー</h1>
        <p id="session-label" class="session-label">集中セッション</p>
        <p id="timer-display" class="timer-display" aria-live="polite">25:00</p>
        <p id="status-text" class="status-text">好みに合わせて設定し、開始ボタンでセッションを始めましょう。</p>
        <div class="timer-actions">
          <button id="start-pause-button" type="button">開始</button>
          <button id="reset-button" type="button" class="secondary-button">リセット</button>
          <button id="skip-button" type="button" class="secondary-button">スキップ</button>
        </div>
      </section>

      <section class="settings-card" aria-labelledby="settings-heading">
        <div class="settings-header">
          <h2 id="settings-heading">設定</h2>
          <p>各設定はブラウザーに保存されます。</p>
        </div>

        <div class="settings-grid">
          <label class="setting-field">
            <span>集中時間</span>
            <select id="focus-duration" aria-label="集中時間">
              <option value="15">15分</option>
              <option value="25">25分</option>
              <option value="35">35分</option>
              <option value="45">45分</option>
            </select>
          </label>

          <label class="setting-field">
            <span>休憩時間</span>
            <select id="break-duration" aria-label="休憩時間">
              <option value="5">5分</option>
              <option value="10">10分</option>
              <option value="15">15分</option>
            </select>
          </label>

          <label class="setting-field">
            <span>テーマ</span>
            <select id="theme-select" aria-label="テーマ">
              <option value="dark">ダーク</option>
              <option value="light">ライト</option>
              <option value="focus">フォーカス</option>
            </select>
          </label>
        </div>

        <fieldset class="sound-settings">
          <legend>サウンド</legend>
          <label><input id="sound-start" type="checkbox"> 開始音</label>
          <label><input id="sound-end" type="checkbox"> 終了音</label>
          <label><input id="sound-tick" type="checkbox"> tick音</label>
        </fieldset>
      </section>

      <section class="dashboard card metrics">
        <div>
          <p class="label">レベル</p>
          <p class="value">Lv <%= dashboard.level %></p>
        </div>
        <div>
          <p class="label">経験値（XP）</p>
          <p class="value"><%= dashboard.xp %> XP</p>
          <p class="subtle">次のレベルまで <%= dashboard.xpToNextLevel %> XP</p>
        </div>
        <div>
          <p class="label">連続達成</p>
          <p class="value"><%= dashboard.streakDays %> 日</p>
        </div>
      </section>

      <section class="dashboard card">
        <h2>タイマー完了を記録</h2>
        <form method="post" action="/timer/complete" class="complete-form">
          <input id="focus-minutes-input" name="focusMinutes" type="hidden" value="25">
          <p class="complete-form-copy">現在の集中時間設定でセッション完了を記録します。</p>
          <button type="submit">+ セッション完了</button>
        </form>
      </section>

      <section class="dashboard card">
        <h2>達成バッジ</h2>
        <div class="badges">
          <% dashboard.badges.forEach((badge) => { %>
            <span class="badge <%= badge.unlocked ? 'unlocked' : 'locked' %>"><%= badge.name %></span>
          <% }) %>
        </div>
      </section>

      <section class="dashboard card">
        <h2>週間詳細統計</h2>
        <p class="subtle">完了率: <%= dashboard.weeklyStats.summary.completionRate %>% / 平均集中時間: <%= dashboard.weeklyStats.summary.avgFocusMinutes %>分</p>
        <ul class="graph-list">
          <% dashboard.weeklyStats.items.forEach((item) => { %>
            <li>
              <span class="graph-label"><%= item.label %></span>
              <div class="bar completion"><span style="width: <%= item.completionRate %>%"></span></div>
              <span class="graph-value"><%= item.completionRate %>%</span>
            </li>
          <% }) %>
        </ul>
      </section>

      <section class="dashboard card">
        <h2>月間詳細統計</h2>
        <p class="subtle">完了率: <%= dashboard.monthlyStats.summary.completionRate %>% / 平均集中時間: <%= dashboard.monthlyStats.summary.avgFocusMinutes %>分</p>
        <ul class="graph-list">
          <% dashboard.monthlyStats.items.forEach((item) => { %>
            <li>
              <span class="graph-label"><%= item.label %></span>
              <div class="bar focus"><span style="width: <%= Math.min(100, Math.round((item.avgFocusMinutes / 60) * 100)) %>%"></span></div>
              <span class="graph-value"><%= item.avgFocusMinutes %>分</span>
            </li>
          <% }) %>
        </ul>
      </section>
    </main>

    <script src="/js/app.js"></script>
  </body>
</html>
